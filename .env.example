# Supabase project API settings. The app throws at startup without these.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only, set on the Vercel project rather than here: a
# fine-grained token with Issues: Read and write, used by /api/feedback to
# file the in-app feedback form as a GitHub issue. See the README.
# GITHUB_TOKEN=

# Public Spotify app client id, used by Music Timeline so the host can sign
# in and their browser becomes the speaker for the room. There is no client
# secret: the app uses Authorization Code with PKCE, which is the flow for
# a client that cannot keep one. Leave it empty and the game still plays,
# just without audio. See the README for the dashboard setup.
VITE_SPOTIFY_CLIENT_ID=

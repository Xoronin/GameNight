# Supabase project API settings. The app throws at startup without these.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only, set on the Vercel project rather than here: a
# fine-grained token with Issues: Read and write, used by /api/feedback to
# file the in-app feedback form as a GitHub issue. See the README.
# GITHUB_TOKEN=
